# 서버 포트 (기본값 3000)
PORT=3000
# RSS 요청 타임아웃(ms)
FEED_TIMEOUT_MS=8000
# 피드 캐시 유지 시간(초)
CACHE_TTL_SEC=300

# AI 요약 기능용 Anthropic API 키 (없으면 AI 요약 버튼이 안내 메시지를 보여줌)
ANTHROPIC_API_KEY=
# AI 요약에 사용할 모델 (기본값: claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# 하루 최대 AI 요약 호출 수 (초과하면 자동으로 기본 요약 사용)
AI_DAILY_LIMIT=100

# 네이버 뉴스 검색 API (https://developers.naver.com 에서 발급, 무료)
# 설정하면 네이버 뉴스를 사용하고, 비워 두면 구글 뉴스 RSS를 사용한다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
